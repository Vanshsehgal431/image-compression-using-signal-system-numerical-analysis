from PIL import Image
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

uploaded = files.upload()
filename = next(iter(uploaded))

img = np.array(Image.open(filename).convert("L"), dtype=np.float64)

print("Image shape:", img.shape)
plt.imshow(img, cmap="gray")
plt.title("Original Image")
plt.axis("off");

# 1. Optional 3x3 averaging filter (edge padding)
use_filter = True

if use_filter:
    padded = np.pad(img, 1, mode="edge")
    filtered = sum(
        padded[i:i+img.shape[0], j:j+img.shape[1]]
        for i in range(3) for j in range(3)
    ) / 9
else:
    filtered = img.copy()

# 2. Quantization function
def quantize(image, L):
    delta = 256 / L
    indices = np.clip(np.round(image / delta), 0, L-1)
    reconstructed = np.clip(indices * delta, 0, 255)
    return reconstructed

# 3. Calculate MSE and PSNR
def metrics(original, reconstructed):
    mse = np.mean((original - reconstructed) ** 2)
    psnr = float("inf") if mse == 0 else 10 * np.log10(255**2 / mse)
    return mse, psnr

# 4. Test different quantization levels
levels = [2, 4, 8, 16, 32, 64, 128, 256]
results = []

for L in levels:
    reconstructed = quantize(filtered, L)
    mse, psnr = metrics(img, reconstructed)  # Total error vs original
    bits = int(np.log2(L))
    compression_ratio = 8 / bits
    theoretical_mse = (256 / L)**2 / 12

    results.append((L, mse, psnr, bits, compression_ratio, theoretical_mse))

# 5. Display results
print("L | MSE | PSNR | Bits/pixel | Compression Ratio | Theoretical MSE")
for r in results:
    print(f"{r[0]:3} | {r[1]:9.2f} | {r[2]:8.2f} | {r[3]:2} | {r[4]:8.2f}:1 | {r[5]:10.2f}")

# 6. Select smallest L satisfying maximum allowed MSE
Emax = 100  # Change this value as needed

valid = [r for r in results if r[1] <= Emax]

if valid:
    best_L = min(valid, key=lambda r: r[0])[0]
    compressed = quantize(filtered, best_L)
    print("\nSelected L:", best_L)
else:
    best_L = None
    compressed = None
    print("\nNo L satisfies the selected MSE limit.")

# 7. Display original, filtered and reconstructed images
if compressed is not None:
    fig, ax = plt.subplots(1, 3, figsize=(15, 5))
    for a, image, title in zip(
        ax, [img, filtered, compressed],
        ["Original", "Filtered", f"Compressed (L={best_L})"]
    ):
        a.imshow(image, cmap="gray", vmin=0, vmax=255)
        a.set_title(title)
        a.axis("off")
    plt.show()

    # 8. Save reconstructed image
    output = "compressed_image.png"
    Image.fromarray(compressed.astype(np.uint8)).save(output)
    files.download(output)

# 9. Plot MSE and PSNR against quantization levels
Ls = [r[0] for r in results]
mses = [r[1] for r in results]
psnrs = [r[2] for r in results]

fig, ax = plt.subplots(1, 2, figsize=(12, 4))

ax[0].plot(Ls, mses, marker="o")
ax[0].set_xscale("log", base=2)
ax[0].set_title("MSE vs Quantization Levels")
ax[0].set_xlabel("L")
ax[0].set_ylabel("MSE")
ax[0].grid()

ax[1].plot(Ls, psnrs, marker="o")
ax[1].set_xscale("log", base=2)
ax[1].set_title("PSNR vs Quantization Levels")
ax[1].set_xlabel("L")
ax[1].set_ylabel("PSNR (dB)")
ax[1].grid()

plt.tight_layout()
plt.show()
